<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="CitasPorEspecialidad" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail">
    
    <parameter name="fechaInicio" class="java.time.LocalDate"/>
    <parameter name="fechaFin" class="java.time.LocalDate"/>
    
    <field name="medico.especialidad" class="java.lang.String"/>
    <field name="fecha" class="java.time.LocalDate"/>
    <field name="hora" class="java.time.LocalTime"/>
    <field name="medico.nombre" class="java.lang.String"/>
    <field name="medico.apellido" class="java.lang.String"/>
    <field name="paciente.nombre" class="java.lang.String"/>
    <field name="paciente.apellido" class="java.lang.String"/>
    
    <variable name="CitasPorEspecialidad" class="java.lang.Integer" resetType="Group" resetGroup="EspecialidadGroup" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    
    <group name="EspecialidadGroup">
        <groupExpression><![CDATA[$F{medico.especialidad}]]></groupExpression>
        <groupHeader>
            <band height="30">
                <textField>
                    <reportElement x="0" y="0" width="555" height="30"/>
                    <textElement>
                        <font size="14" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Especialidad: " + $F{medico.especialidad}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="20">
                <textField>
                    <reportElement x="0" y="0" width="555" height="20"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Total de citas: " + $V{CitasPorEspecialidad}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>
    
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Citas por Especialidad]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Periodo: " + $P{fechaInicio} + " - " + $P{fechaFin}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="0" y="0" width="80" height="20"/>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="80" y="0" width="60" height="20"/>
                <text><![CDATA[Hora]]></text>
            </staticText>
            <staticText>
                <reportElement x="140" y="0" width="200" height="20"/>
                <text><![CDATA[Médico]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="215" height="20"/>
                <text><![CDATA[Paciente]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="80" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{hora}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="140" y="0" width="200" height="20"/>
                <textFieldExpression><![CDATA[$F{medico.nombre} + " " + $F{medico.apellido}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="340" y="0" width="215" height="20"/>
                <textFieldExpression><![CDATA[$F{paciente.nombre} + " " + $F{paciente.apellido}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="455" y="0" width="100" height="30"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total General de Citas: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[No se encontraron citas para el período seleccionado]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>