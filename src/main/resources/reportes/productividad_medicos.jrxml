<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ProductividadMedicos" pageWidth="595" pageHeight="842" whenNoDataType="AllSectionsNoDetail">
    
    <parameter name="fechaInicio" class="java.time.LocalDate"/>
    <parameter name="fechaFin" class="java.time.LocalDate"/>
    
    <field name="medico.nombre" class="java.lang.String"/>
    <field name="medico.apellido" class="java.lang.String"/>
    <field name="medico.especialidad" class="java.lang.String"/>
    <field name="fecha" class="java.time.LocalDate"/>
    <field name="estado" class="java.lang.String"/>
    
    <variable name="CitasPorMedico" class="java.lang.Integer" resetType="Group" resetGroup="MedicoGroup" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    
    <variable name="CitasCompletadas" class="java.lang.Integer" resetType="Group" resetGroup="MedicoGroup" calculation="Count">
        <variableExpression><![CDATA[$F{estado}.equals("COMPLETADA")]]></variableExpression>
        <initialValueExpression><![CDATA[0]]></initialValueExpression>
    </variable>
    
    <group name="MedicoGroup">
        <groupExpression><![CDATA[$F{medico.nombre} + " " + $F{medico.apellido}]]></groupExpression>
        <groupHeader>
            <band height="40">
                <textField>
                    <reportElement x="0" y="0" width="555" height="20"/>
                    <textElement>
                        <font size="12" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Dr(a). " + $F{medico.nombre} + " " + $F{medico.apellido}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="20" y="20" width="535" height="20"/>
                    <textElement>
                        <font isItalic="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Especialidad: " + $F{medico.especialidad}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="40">
                <textField>
                    <reportElement x="20" y="0" width="535" height="20"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Total de citas: " + $V{CitasPorMedico}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="20" y="20" width="535" height="20"/>
                    <textElement>
                        <font isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Citas completadas: " + $V{CitasCompletadas} + " (" + 
                        String.format("%.1f%%", ($V{CitasCompletadas}.doubleValue() / $V{CitasPorMedico}.doubleValue()) * 100) + ")"]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>
    
    <title>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Productividad de Médicos]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="30" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Periodo: " + $P{fechaInicio} + " - " + $P{fechaFin}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement x="20" y="0" width="100" height="20"/>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="120" y="0" width="435" height="20"/>
                <text><![CDATA[Estado de la Cita]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20">
            <textField>
                <reportElement x="20" y="0" width="100" height="20"/>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="120" y="0" width="435" height="20"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="455" y="0" width="100" height="30"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="30">
            <textField>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total de Médicos Evaluados: " + $V{MedicoGroup_COUNT}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
    
    <noData>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[No se encontraron datos de productividad para el período seleccionado]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>