<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ReporteCitas" pageWidth="595" pageHeight="842" columnWidth="555"
    leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <parameter name="fechaInicio" class="java.lang.String"/>
    <parameter name="fechaFin" class="java.lang.String"/>
    <parameter name="totalCitas" class="java.lang.Integer"/>
    <parameter name="citasCompletadas" class="java.lang.Long"/>
    <parameter name="citasCanceladas" class="java.lang.Long"/>
    
    <field name="idCita" class="java.lang.Integer"/>
    <field name="fecha" class="java.time.LocalDate"/>
    <field name="hora" class="java.time.LocalTime"/>
    <field name="paciente.nombre" class="java.lang.String"/>
    <field name="paciente.apellido" class="java.lang.String"/>
    <field name="medico.nombre" class="java.lang.String"/>
    <field name="medico.apellido" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>
    
    <title>
        <band height="79" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de Citas Médicas]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA["Período: " + $P{fechaInicio} + " - " + $P{fechaFin}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <pageHeader>
        <band height="50">
            <textField>
                <reportElement x="0" y="10" width="185" height="20"/>
                <textFieldExpression><![CDATA["Total de Citas: " + $P{totalCitas}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="185" y="10" width="185" height="20"/>
                <textFieldExpression><![CDATA["Completadas: " + $P{citasCompletadas}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="370" y="10" width="185" height="20"/>
                <textFieldExpression><![CDATA["Canceladas: " + $P{citasCanceladas}]]></textFieldExpression>
            </textField>
        </band>
    </pageHeader>
    
    <columnHeader>
        <band height="30">
            <staticText>
                <reportElement x="0" y="0" width="50" height="20"/>
                <text><![CDATA[ID]]></text>
            </staticText>
            <staticText>
                <reportElement x="50" y="0" width="80" height="20"/>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement x="130" y="0" width="60" height="20"/>
                <text><![CDATA[Hora]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="120" height="20"/>
                <text><![CDATA[Paciente]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="120" height="20"/>
                <text><![CDATA[Médico]]></text>
            </staticText>
            <staticText>
                <reportElement x="430" y="0" width="125" height="20"/>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>
    
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{idCita}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="0" width="60" height="20"/>
                <textFieldExpression><![CDATA[$F{hora}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="190" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{paciente.nombre} + " " + $F{paciente.apellido}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="310" y="0" width="120" height="20"/>
                <textFieldExpression><![CDATA[$F{medico.nombre} + " " + $F{medico.apellido}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="125" height="20"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <noData>
        <band height="50">
            <staticText>
                <reportElement x="0" y="0" width="555" height="50"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[No se encontraron citas para el período seleccionado]]></text>
            </staticText>
        </band>
    </noData>

    <pageFooter>
        <band height="54" splitType="Stretch">
            <textField>
                <reportElement x="455" y="34" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>
</jasperReport>