<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
    name="ReporteEstadistico" pageWidth="595" pageHeight="842" columnWidth="555"
    leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
    
    <parameter name="totalCitas" class="java.lang.Long"/>
    <parameter name="totalMedicos" class="java.lang.Long"/>
    <parameter name="totalEspecialidades" class="java.lang.Long"/>
    <parameter name="citasProgramadas" class="java.lang.Long"/>
    <parameter name="citasCompletadas" class="java.lang.Long"/>
    <parameter name="citasCanceladas" class="java.lang.Long"/>
    <parameter name="citasNoAsistidas" class="java.lang.Long"/>
    <parameter name="citasMesActual" class="java.lang.Long"/>
    
    <title>
        <band height="79" splitType="Stretch">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="18" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte Estadístico del Sistema]]></text>
            </staticText>
            <textField pattern="MMMMM dd, yyyy">
                <reportElement x="0" y="40" width="555" height="20"/>
                <textElement textAlignment="Center"/>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </title>
    
    <detail>
        <band height="400">
            <!-- Estadísticas Generales -->
            <staticText>
                <reportElement x="0" y="20" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Estadísticas Generales]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="55" width="200" height="20"/>
                <text><![CDATA[Total de Citas Registradas:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="55" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{totalCitas}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="85" width="200" height="20"/>
                <text><![CDATA[Total de Médicos:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="85" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{totalMedicos}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="115" width="200" height="20"/>
                <text><![CDATA[Total de Especialidades:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="115" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{totalEspecialidades}]]></textFieldExpression>
            </textField>
            
            <!-- Estadísticas de Citas -->
            <staticText>
                <reportElement x="0" y="160" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado de las Citas]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="195" width="200" height="20"/>
                <text><![CDATA[Citas Programadas:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="195" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{citasProgramadas}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="225" width="200" height="20"/>
                <text><![CDATA[Citas Completadas:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="225" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{citasCompletadas}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="255" width="200" height="20"/>
                <text><![CDATA[Citas Canceladas:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="255" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{citasCanceladas}]]></textFieldExpression>
            </textField>
            
            <staticText>
                <reportElement x="20" y="285" width="200" height="20"/>
                <text><![CDATA[Citas No Asistidas:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="285" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{citasNoAsistidas}]]></textFieldExpression>
            </textField>
            
            <!-- Estadísticas del Mes -->
            <staticText>
                <reportElement x="0" y="330" width="555" height="25"/>
                <textElement>
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Estadísticas del Mes Actual]]></text>
            </staticText>
            
            <staticText>
                <reportElement x="20" y="365" width="200" height="20"/>
                <text><![CDATA[Total de Citas este Mes:]]></text>
            </staticText>
            <textField>
                <reportElement x="220" y="365" width="100" height="20"/>
                <textFieldExpression><![CDATA[$P{citasMesActual}]]></textFieldExpression>
            </textField>
        </band>
    </detail>
    
    <pageFooter>
        <band height="54" splitType="Stretch">
            <textField>
                <reportElement x="455" y="34" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="34" width="250" height="20"/>
                <text><![CDATA[Sistema de Gestión de Citas Médicas]]></text>
            </staticText>
        </band>
    </pageFooter>
</jasperReport>